{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.buildDirectory": "${workspaceFolder}/build/debug",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "files.associations": {
    "*.hpp": "cpp",
    "iostream": "cpp",
    "vector": "cpp",
    "list": "cpp",
    "unordered_map": "cpp",
    "queue": "cpp",
    "stack": "cpp"
  },
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#ed54cd",
    "activityBar.background": "#ed54cd",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#bce718",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#ed54cd",
    "statusBar.background": "#e826bf",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#ed54cd",
    "statusBarItem.remoteBackground": "#e826bf",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#e826bf",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#e826bf99",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#e826bf"
}

